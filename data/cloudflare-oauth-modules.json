{
  "source": "cf built-in command modules",
  "version": 1,
  "modules": [
    {
      "id": "auth",
      "name": "Authentication",
      "description": "Verify the signed-in Cloudflare identity.",
      "scopes": [
        "user-details.read"
      ],
      "tier": "basic"
    },
    {
      "id": "zones",
      "name": "Zones",
