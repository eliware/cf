      "scopes": [
        "zone.read",
        "zone.write"
      ],
      "tier": "basic"
    },
    {
      "id": "dns",
      "name": "DNS",
      "description": "Inspect and manage DNS records and desired-state diffs.",
      "scopes": [
        "dns.read",
        "dns.write"
      ],
      "tier": "basic"
    },
    {
      "id": "zone-settings",
      "name": "Zone settings",
