{
    "name": "@eliware/cf-admin",
    "version": "1.0.7",
    "description": "Cloudflare administration CLI for zones, DNS, rulesets, settings, lists, GitOps workflows, and infrastructure automation.",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "test": "npx --node-options=\"--experimental-vm-modules --no-warnings\" jest --coverage --detectOpenHandles --silent",
        "lint": "oxlint ."
    },
    "keywords": [
        "cloudflare",
        "cli",
        "cloudflare-api",
        "dns",
        "waf",
        "rulesets",
        "zero-trust",
        "security",
        "devops",
        "gitops",
        "infrastructure-as-code",
        "automation",
        "typescript",
        "javascript",
        "nodejs"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "cloudflare": "^6.5.0"
    },
    "bin": {
        "cf-admin": "bin/cf-admin.mjs"
    },
    "devDependencies": {
        "jest": "^30.0.4",
        "oxlint": "^1.73.0"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/?(*.)+(spec|test).[jt]s?(x)",
            "**/?(*.)+(spec|test).mjs",
            "**/?(*.)+(spec|test).cjs"
        ],
        "coveragePathIgnorePatterns": [
            "/bin/"
        ]
    },
    "allowScripts": {
        "unrs-resolver@1.12.2": true
    },
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/eliware/cf-admin.git"
    },
    "homepage": "https://github.com/eliware/cf-admin",
    "bugs": {
        "url": "https://github.com/eliware/cf-admin/issues"
    }
}